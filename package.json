{
  "name": "gymtracker",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios --simulator=\"iPhone  17 Pro\"",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "start": "react-native start --reset-cache",
    "start:clean": "react-native start --reset-cache",
    "test": "jest",
    "test:co": "yarn test --coverage",
    "test:u": "yarn test --updateSnapshot",
    "format": "prettier --write \"**/*.{ts,tsx,js,json}\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@op-engineering/op-sqlite": "^11.0.4",
    "@react-native/new-app-screen": "0.84.1",
    "@react-navigation/bottom-tabs": "^7.16.1",
    "@react-navigation/material-top-tabs": "^7.4.27",
    "@react-navigation/native": "^7.2.4",
    "@react-navigation/native-stack": "^7.14.5",
    "drizzle-orm": "^0.45.2",
    "i18next": "^26.3.6",
    "react": "19.2.3",
    "react-i18next": "^17.0.11",
    "react-native": "0.84.1",
    "react-native-biometrics": "^3.0.1",
    "react-native-gesture-handler": "^2.31.2",
    "react-native-keychain": "^9.1.0",
    "react-native-mmkv": "^3.2.0",
    "react-native-pager-view": "^8.0.1",
    "react-native-reanimated": "^4.5.3",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "^4.25.0",
    "react-native-svg": "^15.15.5",
    "react-native-worklets": "^0.11.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^9.31.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.84.1",
    "@react-native/metro-config": "0.84.1",
    "@react-native/typescript-config": "0.84.1",
    "@testing-library/react-native": "^13.2.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "babel-plugin-module-resolver": "^5.0.3",
    "commit-message-validator": "^1.0.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-native": "^5.0.0",
    "globals": "^16.2.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-extended": "^4.0.2",
    "lint-staged": "^17.0.8",
    "prettier": "^3.8.1",
    "react-native-svg-transformer": "^1.5.3",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3",
    "validate-branch-name": "^1.3.2"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "config": {
    "commit-message-validator": {
      "pattern": "^GT-\\d+: .+",
      "errorMessage": "Commit message must match: GT-{number}: Your message (e.g. GT-42: Add workout screen)"
    }
  },
  "validate-branch-name": {
    "pattern": "^(main|develop)$|^(story|task|bugfix|hotfix)/GT-\\d+",
    "errorMsg": "Please rename your branch name. It must match: (story|task|bugfix|hotfix)/GT-{number} (e.g. task/GT-42)"
  },
  "packageManager": "yarn@4.10.3+sha512.c38cafb5c7bb273f3926d04e55e1d8c9dfa7d9c3ea1f36a4868fa028b9e5f72298f0b7f401ad5eb921749eb012eb1c3bb74bf7503df3ee43fd600d14a018266f"
}
